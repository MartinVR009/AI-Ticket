# Servidor Backend
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Base de Datos PostgreSQL (Nativo sin ORM)
# Para Docker Compose usar DB_HOST=db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contrasena_postgres
DB_NAME=tickets
DATABASE_URL=postgresql://postgres:tu_contrasena_postgres@localhost:5432/tickets

# Proveedor de Inteligencia Artificial (Google Gemini)
GEMINI_API_KEY=tu_clave_api_gemini_aqui
GEMINI_PROJECT_NAME=projects/tu_numero_de_proyecto
GEMINI_PROJECT_NUMBER=tu_numero_de_proyecto
GEMINI_MODEL=gemini-flash-latest

# Opcional: Proveedor alternativo OpenAI
OPENAI_API_KEY=
